# Git holds source and conclusions. Large data snapshots are archived in
# GitHub Release; the Cloudflare D1 mirror was retired on 2026-10-01.
# See docs/ARCHIVE.md for scope, verification, and restore instructions.

# --- Environment: rebuild with tools/bootstrap.sh --------------------------
venv/
.cache/

# --- Credentials: never commit. Each collaborator supplies their own. ------
.kaggle/
*.secret
.secret*
.kilo
# --- Generated: rebuild from source, never hand-edit ----------------------
# 594 strategies from agents/_engine.py + tools/registry.py
# Every agents/<dir> containing generated strategies. `registry.py gen --out`
# can name any of them, so the rule is: only these three are hand-written.
agents/*/
!agents/enhanced/
!agents/legacy/
# rendered from data/arena.sqlite by tools/leaderboard.py
site/
# built from an agent file by tools/build_notebook.py
notebooks/*.ipynb

# --- Data: local evidence; frozen snapshots are in GitHub Release ---------
data/
# compressed snapshots produced by tools/sync.py
dist/
# ...except the trace library snapshot. 371 mined ladder plans in 3 MB, and the
# only thing here that costs an hour of rate-limited Kaggle pulling to rebuild.
# It is not in the database and not mirrored to D1 -- see docs/TOOLS.md.
!dist/
dist/*
!dist/tracelib.json.xz

# --- Run output -----------------------------------------------------------
# Slurm stdout/stderr, plus the pre-database league dumps (5.2 MB of JSON).
# Their headline results are transcribed into docs/RUNS.md, which is the part
# worth versioning.
logs/

*.pyc
__pycache__/
agents/hybrid/
agents/lines/
agents/term/
agents/wrap/
agents/wrapped/
agents/darkhorse/
rl/runs/
rl/out/
rl/league/
